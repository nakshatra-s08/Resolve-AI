# Application Configuration
APP_NAME=ResolveAI
APP_ENV=development
DEBUG=True

# Database Configuration
# Default: SQLite file located at backend/data/resolveai.db
DATABASE_URL=sqlite:///./data/resolveai.db

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Configuration (comma-separated allowed origins for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
