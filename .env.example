# Application Configuration
APP_NAME=ResolveAI
APP_ENV=development
DEBUG=True

# Database Configuration
# Default: SQLite file located at backend/data/resolveai.db
DATABASE_URL=sqlite:///./data/resolveai.db

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Reasoning Provider Configuration
# Only demo mode is implemented. Credentialed openai/gemini settings return HTTP 503.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Gnani Prisma Speech-to-Text Configuration
# Add your Gnani API key here in your local untracked backend/.env file (never commit actual keys)
GNANI_PRISMA_API_KEY=
GNANI_PRISMA_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_PRISMA_LANGUAGE_CODE=indic-auto

# CORS Configuration (comma-separated allowed origins for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
